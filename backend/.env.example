# Server
PORT=4000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/resto

# Auth
JWT_SECRET=replace_me_with_a_long_random_secret

# Client URL (used in email links / redirects)
CLIENT_URL=http://localhost:5173

# Redis (optional but recommended for caching)
# Example local: redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379

# Inventory ↔ Dishes (recipe/BOM)
# If true, orders will be rejected unless every ordered dish has a configured recipe and sufficient stock.
INVENTORY_REQUIRE_RECIPE=false

# Email (optional)
EMAIL_USER=
EMAIL_PASS=
SMTP_USER=
SMTP_PASS=

# WhatsApp Cloud API (optional - Meta Webhook)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# When using the Meta webhook handler to call protected internal APIs,
# you can set a manager JWT here for demo/testing only.
WHATSAPP_WEBHOOK_JWT=

# WhatsApp (Baileys bot service) internal backend base URL
BACKEND_URL=http://localhost:4000

# AI providers (optional)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
ANTHROPIC_API_KEY=
COHERE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# Weather (optional)
OPENWEATHER_API_KEY=
# Server
PORT=4000

# Database (required)
MONGO_URI=mongodb://localhost:27017/resto

# Auth (required)
JWT_SECRET=replace_me_with_a_strong_secret

# Frontend URL (used for links like password reset)
CLIENT_URL=http://localhost:5173

# Redis (optional but recommended for caching)
REDIS_URL=

# Inventory ↔ Dishes (recipe/BOM)
INVENTORY_REQUIRE_RECIPE=false

# Email (optional - used by password reset / notifications)
EMAIL_USER=
EMAIL_PASS=
SMTP_USER=
SMTP_PASS=

# Internal backend base URL (used by WhatsApp services)
BACKEND_URL=http://localhost:4000

# WhatsApp (Baileys QR mode)
# No env required for basic local QR pairing.

# WhatsApp (Meta Cloud API) - optional
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# If using the Meta webhook handler to call protected internal APIs,
# provide a valid manager JWT here for demo purposes.
WHATSAPP_WEBHOOK_JWT=

# AI / analytics keys (optional)
OPENWEATHER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
ANTHROPIC_API_KEY=
COHERE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
